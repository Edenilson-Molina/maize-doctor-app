{
  "expo": {
    "name": "DoctorMaiz",
    "slug": "doctor-maiz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "doctormaiz",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doctormaiz.app"
    },
    "android": {
      "package": "com.doctormaiz.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "DoctorMaiz necesita acceso a la cámara para escanear hojas de maíz."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DoctorMaiz necesita acceso a tus fotos para analizar una imagen existente."
        }
      ],
      "react-native-fast-tflite"
    ]
  }
}
