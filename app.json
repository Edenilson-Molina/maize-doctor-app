{
  "expo": {
    "name": "DoctorMaiz",
    "slug": "doctor-maiz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "doctormaiz",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doctormaiz.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DoctorMaiz necesita tu ubicación para registrar dónde se tomaron los escaneos en el campo."
      }
    },
    "android": {
      "package": "com.doctormaiz.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyDevKeyForDoctorMaizApp12345678"
        }
      }
    },
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "DoctorMaiz necesita acceso a la cámara para escanear hojas de maíz.",
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DoctorMaiz necesita acceso a tus fotos para analizar una imagen existente."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "DoctorMaiz necesita tu ubicación para registrar dónde se tomaron los escaneos en el campo."
        }
      ],
      "react-native-fast-tflite",
      "./plugins/withReleaseSigning"
    ]
  }
}
