# Copia a android/keystore.properties (ignorado por git) para firmar los APK de release
# con una keystore estable. Sin este archivo el release cae a la keystore de debug.
#
# Generar la keystore una sola vez y respaldarla fuera del repo: si se pierde, Android ya no
# acepta actualizaciones del mismo applicationId y hay que publicar una app nueva.
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore maize-doctor-release.keystore \
#     -alias maize-doctor -keyalg RSA -keysize 2048 -validity 10000
#
# MAIZE_STORE_FILE se resuelve relativo a android/app/.
MAIZE_STORE_FILE=../../maize-doctor-release.keystore
MAIZE_STORE_PASSWORD=cambiame
MAIZE_KEY_ALIAS=maize-doctor
MAIZE_KEY_PASSWORD=cambiame
